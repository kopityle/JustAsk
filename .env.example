# === Secrets (required) ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_random_string_at_least_32_chars
LTI_CONSUMER_KEY=replace_with_moodle_consumer_key
LTI_SHARED_SECRET=replace_with_random_string

# === Ollama / RAG ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# FastEmbed model (ONNX, CPU); downloaded once into the local cache
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DISTANCE_THRESHOLD=0.50

# === Access / limits ===
ALLOW_GUEST_WRITES=false
MAX_UPLOAD_SIZE=52428800