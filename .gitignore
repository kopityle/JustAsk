# Python кэш и виртуальное окружение
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
venv/
.env

# Тесты и покрытие
.pytest_cache/
.coverage
htmlcov/

# Локальная векторная база и сгенерированные данные
data/chroma/
*.pid

# Учебные PDF (копирайт) и рантайм-данные
data/docs/*.pdf
data/feedback.*

# Интерактивные Locust-отчёты (остаются локально, в репо PDF-экспорт)
benchmarks/results/*.html

# Служебные папки агентов 
.opencode/
.impeccable/
.refact/

# Настройки IDE и редакторов
.idea/
.vscode/
*.swp
*.swo
docs/.obsidian/workspace.json

# Системные файлы ОС
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
